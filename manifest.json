{
    "name": "__MSG_extension_name__",
    "version": "1.2",
    "description": "__MSG_description__",
    "manifest_version": 3,

    "permissions": ["tabs", "activeTab", "scripting", "storage", "windows", "commands", "notifications"],

    "icons": {
        "16": "icons/16icon.png",
        "48": "icons/48icon.png",
        "128": "icons/128icon.png"
    },

    "default_locale": "en",

    "action": {
        "default_icon": "icons/48icon.png",
        "default_title": "__MSG_extension_name__",
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "scripts/background.js"
    },

    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    },

    "options_ui": {
        "page": "settings.html",
        "open_in_tab": true
    },

    "commands": {
        "sort_all_tabs": {
            "description": "__MSG_sort_all_tabs__"
        },
        "sort_current_window": {
            "description": "__MSG_sort_current_window__"
        },
        "close_duplicates": {
            "description": "__MSG_close_duplicates__"
        }
    }
}